# Secrets des pronostics / connexion Google — copier en web/.env (non commité), puis
# `docker compose up -d --build`. Compose charge automatiquement web/.env.
# Si ces variables restent vides, l'auth est désactivée et l'app tourne en lecture seule.
#
# Créer l'identifiant : Google Cloud Console -> APIs & Services -> Identifiants ->
#   « Créer des identifiants » -> ID client OAuth 2.0 -> type « Application Web ».
#   URI de redirection autorisé (EXACT) : https://analyzer.wiriath.com/api/auth/callback
#   (écran de consentement OAuth configuré : scopes openid/email/profile).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Clé aléatoire pour signer le cookie de session (ex. `python3 -c "import secrets;print(secrets.token_hex(32))"`)
FH_SESSION_SECRET=
# Emails Google (séparés par des virgules) autorisés à créer/fermer/régler les paris spéciaux.
FH_ADMIN_EMAILS=
